-- Pull in the wezterm API --
local wezterm = require 'wezterm'

-- local resurrect = wezterm.plugin.require("https://github.com/MLFlexer/resurrect.wezterm")

-- This table will hold the configuration. --
local config = {}

-- In newer versions of wezterm, use the config_builder which will
-- help provide clearer error messages --
if wezterm.config_builder then
  config = wezterm.config_builder()
end

-- This is where you actually apply your config choices --

-- For example, changing the color scheme: --
config.color_scheme = 'Catppuccin Mocha'

config.colors = {
  background = '#13131e',
}

config.inactive_pane_hsb = {
  saturation = 0.4,
  brightness = 0.7,
}

-- size --
config.initial_rows = 46
config.initial_cols = 235

-- Fonts --
-- local font = 'FantasqueSansM Nerd Font Mono'
-- local font = 'ProFontWindows Nerd Font Mono'
-- local font = 'SpaceMono Nerd Font Mono'
local font = 'IosevkaTerm Nerd Font Mono'
config.font = wezterm.font(font, { weight = 'Medium' })
config.font_size = 26
config.cell_width = 1.05

-- Tab bar --
config.window_frame = {
  font = wezterm.font(font, { weight = 'ExtraBold' }),
  font_size = 16,
}
config.tab_max_width = 35

-- From: https://github.com/azzamsa/dot/blob/3c0ef45499977a25dc7c8adf26b9e13da63f8bd6/wezterm/.config/wezterm/wezterm.lua#L15-L19
function strip_home_name(text)
  local username = os.getenv("USER")
  clean_text = text:gsub("/Users/" .. username, "~")
  return clean_text
end

wezterm.on('format-tab-title', function(tab, tabs, panes, config, hover, max_width)
  local cwd = strip_home_name(tab.active_pane.current_working_dir.file_path)
  local tab_index = tab.tab_index
  local tab_info = (tab_index < 8) and (tab_index + 1 .. ' ') or ' '
  local title = ' 📁' .. tab_info .. cwd

  if (tab.is_active) then
    return {
      { Background = { Color = '#7ca6fb' } },
      { Foreground = { Color = '#111126' } },
      { Text = title },
    }
  end

  return {
    { Background = { Color = '#222222' } },
    { Foreground = { Color = '#eeeeee' } },
    { Text = title },
  }
end)

wezterm.on('format-window-title', function(tab, pane, tabs, panes, config)
  local cwd = strip_home_name(tab.active_pane.current_working_dir.file_path)
  local title = ' 📁 ' .. cwd

  local tab_tally = ''
  if #tabs > 1 then
    tab_tally = string.format('%d/%d', tab.tab_index + 1, #tabs)
  end

  return tab_tally .. title .. ' 🖥️ wezterm'
end)

local act = wezterm.action

-- mouse actions --
config.mouse_bindings = {
  -- Doesn't work: https://github.com/wezterm/wezterm/discussions/3672#discussioncomment-7005313
  --[[ -- CMD-click will open the link under the mouse cursor
  {
    event = { Up = { streak = 1, button = "Left" } },
    mods = "SUPER",
    action = wezterm.action.OpenLinkAtMouseCursor,
  }, ]]
  -- Change the default click behaviour so that it only selects
  -- text and doesn't open hyperlinks
  --[[ {
    event = { Down = { streak = 1, button = "Left" } },
    mods = "NONE",
    action = act.Nop,
  },
  {
    event = { Up = { streak = 1, button = "Left" } },
    mods = "NONE",
    action = act.CompleteSelection 'ClipboardAndPrimarySelection',
  }, ]]

  -- and make ALT-Click open hyperlinks
  --[[ {
    event = { Down = { streak = 1, button = "Left" } },
    mods = "ALT",
    action = act.Nop,
  },
  {
    event = { Up = { streak = 1, button = "Left" } },
    mods = "ALT",
    action = act.OpenLinkAtMouseCursor,
  },
  -- and make CMD-Click open hyperlinks
  {
    event = { Down = { streak = 1, button = "Left" } },
    mods = "CMD",
    action = act.Nop,
  },
  {
    event = { Up = { streak = 1, button = "Left" } },
    mods = "CMD",
    action = act.OpenLinkAtMouseCursor,
  },
  -- and make CTRL-Click open hyperlinks
  {
    event = { Down = { streak = 1, button = "Left" } },
    mods = "CTRL",
    action = act.Nop,
  },
  {
    event = { Up = { streak = 1, button = "Left" } },
    mods = "CTRL",
    action = act.OpenLinkAtMouseCursor,
  }, ]]
}

-- keyboard shortcuts --
config.keys = {
  {
    key = 'd',
    mods = 'CMD',
    action = act.SplitHorizontal { domain = 'CurrentPaneDomain' },
  },
  {
    key = 'd',
    mods = 'CMD|CTRL',
    action = act.SplitHorizontal { domain = 'CurrentPaneDomain', args = { 'wezterm cli split-pane --left' } },
  },
  {
    key = 'd',
    mods = 'CMD|SHIFT',
    action = act.SplitVertical { domain = 'CurrentPaneDomain' },
  },
  {
    key = 'w',
    mods = 'CMD',
    action = act.CloseCurrentPane { confirm = true },
  },
  {
    key = 'LeftArrow',
    mods = 'OPT',
    action = act { SendString = "\x1bb" },
  },
  {
    key = 'RightArrow',
    mods = 'OPT',
    action = act { SendString = "\x1bf" },
  },
  {
    key = 'LeftArrow',
    mods = 'CMD',
    action = act { SendString = "\x1bOH" },
  },
  {
    key = 'RightArrow',
    mods = 'CMD',
    action = act { SendString = "\x1bOF" },
  },
  {
    key = '[',
    mods = 'CMD',
    action = act.ActivatePaneDirection 'Next',
  },
  {
    key = 'LeftArrow',
    mods = 'CMD|ALT',
    action = act.ActivateTabRelative(-1),
  },
  {
    key = 'RightArrow',
    mods = 'CMD|ALT',
    action = act.ActivateTabRelative(1),
  },
  --[[ {
    key = 'w',
    mods = 'ALT',
    action = resurrect.window_state.save_window_action(),
  }, ]]
}

-- Debugging --
-- config.debug_key_events = true

-- and finally, return the configuration to wezterm --
return config
